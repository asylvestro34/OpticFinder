[Unit]
Description=OpticFinder WSGI backend
After=network.target

[Service]
Type=simple
User=opticfinder
Group=opticfinder
WorkingDirectory=/opt/opticfinder
Environment=OPTICFINDER_PUBLIC_ORIGIN=https://opticfinder.ddns.net
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:8765 --workers 2 --timeout 30 --max-requests 1000 --max-requests-jitter 100 --error-logfile - --capture-output "opticfinder.wsgi:create_application()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
