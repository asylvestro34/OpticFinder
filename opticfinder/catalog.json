      "scope": "Rugged SX, LX/LH, ZX and copper module specifications, interoperable Gigabit standards, LC/PC or UPC connectors, 2m optical minimum and ZX attenuation/link-budget requirements. LX multimode mode conditioning is not modeled."
    },
    {
      "id": "meraki-ms450", "title": "Meraki MS450 Datasheet",
      "url": "https://documentation.meraki.com/Switching/MS_-_Switches/Product_Information/Overviews_and_Datasheets/MS450_Datasheet",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "MS450-12: twelve 40G QSFP+ and two 100G QSFP28 data ports. Dedicated stacking and management ports, breakout and undocumented downshift modes excluded."
    },
    {
      "id": "meraki-mx67-68", "title": "Meraki MX67 and MX68 Datasheet",
      "url": "https://documentation.meraki.com/SASE_and_SD-WAN/MX/Product_Information/Overviews_and_Datasheets/MX67_and_MX68_Datasheet",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "MX67/W/C: one WAN, three dedicated LAN and one convertible LAN/WAN 1G RJ45. MX68/W/CW: two WAN and ten LAN 1G RJ45. Wireless/cellular variants share the wired port layout."
