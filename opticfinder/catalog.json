    {
      "id": "meraki-ms150", "title": "Meraki MS150 Datasheet",
      "url": "https://documentation.meraki.com/Switching/MS_-_Switches/Product_Information/Overviews_and_Datasheets/MS150_Datasheet",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Twelve exact models, 1G and 5G native port groups, 4G/4X uplinks and listed accessories. Management and dedicated stacking ports excluded."
    },
    {
      "id": "meraki-ms130r", "title": "Meraki MS130R Datasheet",
      "url": "https://documentation.meraki.com/Switching/MS_-_Switches/Product_Information/Overviews_and_Datasheets/MS130R_Datasheet",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "MS130R-8P: eight native 1G RJ45 and two 1G SFP ports. Only the four explicitly listed rugged GLC modules are offered; ordinary MA transceivers are not substituted."
    },
    {
      "id": "cisco-ge-sfp", "title": "Cisco Gigabit Ethernet SFP Data Sheet",
      "url": "https://www.cisco.com/c/en/us/products/collateral/interfaces-modules/gigabit-ethernet-gbic-sfp-modules/datasheet-c78-366584.html",
