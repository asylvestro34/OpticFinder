      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Ten 1G RJ45 LAN, two 1G RJ45 WAN and one 1G SFP WAN physical interfaces. WAN activation depends on firmware and paired interface selection."
    },
    {
      "id": "meraki-mx85", "title": "Meraki MX85 Series Hardware Installation Guide",
      "url": "https://documentation.meraki.com/SASE_and_SD-WAN/MX/Install_and_Get_Started/Installation_Guides/MX85_Series_Hardware_Installation_Guide",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Eight 1G RJ45 and two 1G SFP LAN; two 1G RJ45 and two 1G SFP WAN physical interfaces."
    },
    {
      "id": "meraki-mx95-105", "title": "Meraki MX95/105 Datasheet",
      "url": "https://documentation.meraki.com/SASE_and_SD-WAN/MX/Product_Information/Overviews_and_Datasheets/MX95%2F%2F105_Datasheet",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Four 1G RJ45 and two 10G SFP+ LAN; two 2.5G RJ45 and two 10G SFP+ WAN. SFP+ supports 1G; WAN activation is firmware-dependent. Management port excluded."
    },
    {
      "id": "meraki-mx250", "title": "Meraki MX250 Installation Guide",
      "url": "https://documentation.meraki.com/SASE_and_SD-WAN/MX/Install_and_Get_Started/Installation_Guides/MX250_Installation_Guide",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Eight 1G RJ45, eight 1G SFP and eight 10G SFP+ LAN; two 10G SFP+ WAN. Only documented rated speeds modeled for SFP+ groups. Management port excluded."
    },
    {
      "id": "meraki-mx450", "title": "Meraki MX450 Datasheet",
      "url": "https://documentation.meraki.com/SASE_and_SD-WAN/MX/Product_Information/Overviews_and_Datasheets/MX450_Datasheet",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Eight 1G RJ45, eight 1G SFP and eight 10G SFP+ LAN; two 10G SFP+ WAN. Only documented rated speeds modeled for SFP+ groups. Management port excluded."
    },
    {
      "id": "meraki-mx-wan", "title": "WAN Behavior on MX75/85/95/105",
      "url": "https://documentation.meraki.com/SASE_and_SD-WAN/MX/Product_Information/Overviews_and_Datasheets/WAN_Behavior_on_MX75%2F%2F85%2F%2F95%2F%2F105",
