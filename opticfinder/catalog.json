  "sources": [
    {
      "id": "meraki-ms130",
      "title": "Meraki MS130 Series Installation Guide",
      "url": "https://documentation.meraki.com/Switching/MS_-_Switches/Install_and_Get_Started/Installation_Guides/MS130_Series_Installation_Guide",
      "reviewed_on": "2026-10-20",
      "state": "reviewed",
      "scope": "All eleven MS130 models: physical specifications and port LED speed descriptions. Management ports excluded. Port groups, not physical port numbering, are modeled."
    },
    {
      "id": "meraki-accessories",
      "title": "Meraki SFP and Stacking Accessories",
      "url": "https://documentation.meraki.com/Platform_Management/Product_Information/Overviews_and_Datasheets/Small-Form_Factor_Pluggable_(SFP)_and_Stacking_Accessories",
      "reviewed_on": "2026-10-20",
      "state": "reviewed",
      "scope": "Imported public Meraki-branded transceiver and data-port DAC tables across all listed families. Family and media qualifications are retained separately; physical port modeling is required before a device can be selected. Not the Cisco TMG matrix. Runtime uses the bundled snapshot."
    },
    {
      "id": "copper-rule",
      "title": "OpticFinder twisted-pair channel planning rules",
      "url": "https://documentation.meraki.com/Platform_Management/Product_Information/Overviews_and_Datasheets/Small-Form_Factor_Pluggable_(SFP)_and_Stacking_Accessories",
      "reviewed_on": "2026-10-20",
      "state": "engineering_rule",
      "scope": "Engineering rules, not device-specific category qualifications: certified four-pair Cat5e/Cat6/Cat6A channels including patch leads, 1G/2.5G/5G to 100m. Cat7 and RJ45-compatible Cat8/Cat8.1 are lower-speed alternatives only when the complete channel meets the application's requirements. Cat7 labeling does not establish Class F performance; Cat8.2 connectors are excluded. Only documented native port speeds and qualified accessories are offered. Native RJ45 does not require transceiver qualification."
    },
    {
      "id": "fluke-copper-categories",
      "title": "Fluke Networks Cat8 cabling and connector compatibility",
      "url": "https://www.flukenetworks.com/knowledge-base/applicationstandards-articles-copper/category-8-cabling-fact-sheet",
      "reviewed_on": "2026-10-21", "state": "reviewed",
      "scope": "Cat8 supports 10G and lower applications at 100m when the channel meets application requirements. TIA Cat8 and ISO Cat8.1 are RJ45-compatible; Cat8.2 is not. Shield continuity and termination require verification. Does not qualify device speeds or accessories."
    },
    {
      "id": "fluke-class-f",
      "title": "Fluke Networks Class F cabling guide",
      "url": "https://www.flukenetworks.com/knowledge-base/dtx-cableanalyzer/class-f-dtx-cableanalyzer",
      "reviewed_on": "2026-10-21", "state": "reviewed",
      "scope": "Cat7/Class F connector and channel requirements. A cable category label alone does not establish a Class F channel; RJ45 application compatibility must be checked separately."
    },
    {
      "id": "cisco-mgig-cabling", "title": "Cisco Multigigabit Ethernet Technology",
      "url": "https://www.cisco.com/c/en/us/solutions/collateral/enterprise-networks/catalyst-multigigabit-switching/nb-06-transform-multigigabit-wp-cte-en.html",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "802.3bz multigigabit cabling, 100m reach and Cat5e/Cat6/Cat6A speed table. Does not qualify a device's port or certify an installed cable channel."
    },
    {
      "id": "meraki-lifecycle",
      "title": "Meraki End-of-Life Products and Dates",
      "url": "https://documentation.meraki.com/Platform_Management/Product_Information/End-of-Life_Notices/Meraki_End-of-Life_(EOL)_Products_and_Dates",
      "reviewed_on": "2026-10-20", "state": "reviewed",
      "scope": "Current means not past the published last order date, not the end-of-support date. Snapshot reviewed October 20, 2026; lifecycle changes require catalog review."
